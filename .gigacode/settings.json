{
  "mcpServers": {
    "confluence": {
      "type": "streamable-http",
      "httpUrl": "https://api.sbertrack.sberbank.ru/confluence/mcp",
      "headers": {
        "x-confluence-token": "$secret:confluence/x-confluence-token"
      }
    },
    "jira": {
      "type": "streamable-http",
      "httpUrl": "https://api.sbertrack.sberbank.ru/jira/mcp",
      "headers": {
        "x-jira-token": "$secret:jira/x-jira-token"
      }
    },
    "bitbucket": {
      "type": "streamable-http",
      "httpUrl": "https://my-bitbucket-mcp-server/mcp",
      "headers": {
        "X-Bitbucket-Token": "$secret:bitbucket/X-Bitbucket-Token"
      }
    }
  },
  "ide": {
    "hasSeenNudge": true
  },
  "$version": 4,
  "model": {
    "name": "DeepSeek-V4-Flash-0731",
    "description": "DeepSeek V4 Flash(262k) Reasoning",
    "generationConfig": {
      "extra_body": {
        "chat_template_kwargs": {
          "thinking": true,
          "reasoning_effort": "high"
        }
      }
    }
  },
  "tools": {
    "approvalMode": "auto-edit"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(python -c *)",
      "Bash(python -m pytest *)",
      "Bash(python -m py_compile *)",
      "Bash(.venv/bin/python *)",
      "Bash(pip show *)",
      "Bash(git *)",
      "Bash(ruff *)",
      "Bash(grep *)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(echo *)",
      "Bash(date *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Read(//tmp/**)",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "GrepSearch",
      "Agent(code-pattern-matcher)",
      "Agent(requirements-analyst)",
      "Agent(test-case-designer)",
      "Agent(test-generator)",
      "Agent(test-reviewer)",
      "Agent(test-fixer)",
      "Agent(test-validator)",
      "Skill(api-test-generation)",
      "mcp__jira__zephyr_get_test_case",
      "mcp__jira__zephyr_create_test_case",
      "mcp__jira__zephyr_search_test_cases",
      "mcp__jira__zephyr_get_test_plan",
      "mcp__jira__zephyr_search_test_plans",
      "mcp__jira__zephyr_link_issue_to_test_cases"
    ]
  }
}