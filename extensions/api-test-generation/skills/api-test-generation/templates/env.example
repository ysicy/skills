# Шаблон .env.example для тестового контура: список переменных окружения,
# которые читает код контура (conftest/config). Значений здесь нет.
#
# Значения задаёт окружение запуска: в CI — секрет-хранилище пайплайна,
# локально — так, как принято в команде. Значения в репозиторий не
# коммитятся (см. .gitignore шаблон). Агент генерации тестов эти значения
# не читает и не запрашивает.

# Базовый URL API (обязателен). Переопределяется через переменную окружения.
TEST_BASE_URL=https://your-api.host.example/api/

# Дополнительные разрешённые хосты стенда через запятую. Хост DEFAULT_BASE_URL
# из conftest.py разрешён всегда; на любой другой хост тесты не пойдут, пока
# он не указан здесь.
TEST_ALLOWED_HOSTS=your-api.host.example

# Заголовки тестовых пользователей (имена — из _USERS в conftest.py).
# Значения — из секрет-хранилища/окружения, не из кода.
TEST_USER_1_<HEADER_1>=
TEST_USER_1_<HEADER_2>=

# Дополнительные базовые URL (по необходимости)
TEST_BASE_URL_GATEWAY=https://your-gateway.host.example

# Технический параметр конфига запросов (см. config_template.py)
TECHNICAL_PARAM=100

# Таймаут HTTP-запроса в секундах (опционально, дефолт 60)
HTTP_TIMEOUT=60

# Кол-во ретраев при сбоях (опционально, дефолт 0)
HTTP_RETRIES=0