# Шаблон .env.example для тестового контура.
# Скопируй как `.env` и заполни реальными значениями. Файл `.env`
# НЕ должен попадать в git (см. .gitignore шаблон). Ключи здесь —
# это те же, что читаются через os.environ в conftest/config.
#
# Переменные окружения имеют приоритет над значениями в .env,
# если загрузка настроена как «env, потом .env заполняет недостающее».

# Базовый URL API (обязателен). Переопределяется через переменную окружения.
TEST_BASE_URL=https://your-api.host.example/api/

# Разрешённые хосты стенда через запятую (опционально). Если заданы, тесты
# не пойдут на хост TEST_BASE_URL вне этого списка.
TEST_ALLOWED_HOSTS=your-api.host.example

# Заголовки тестовых пользователей (имена — из _USERS в conftest.py).
# Реальные токены — только здесь, в .env, не в коде.
TEST_USER_1_<HEADER_1>=
TEST_USER_1_<HEADER_2>=

# Дополнительные базовые URL (по необходимости)
TEST_BASE_URL_GATEWAY=https://your-gateway.host.example

# Технический параметр конфига запросов (см. config_template.py)
TECHNICAL_PARAM=100

# Таймаут HTTP-запроса в секундах (опционально, дефолт 60)
HTTP_TIMEOUT=60

# Кол-во ретраев при сбоях (опционально, дефолт 0)
HTTP_RETRIES=0